# .env.example — Variables de entorno para la pila de Docker Compose (Reto 4).
#
# Copia este archivo a `.env` (que está ignorado por git) si quieres sobrescribir
# los valores por defecto que ya vienen fijados en compose.yml:
#   cp .env.example .env
#
# En condiciones normales NO es necesario crear .env: compose.yml ya define los
# valores correctos para que la pila funcione sin preparación manual. Estos
# valores se ofrecen solo como referencia y para experimentación.

# --- Backend ---
# Cadena de conexión a MongoDB. Dentro de la red Docker se usa el hostname del
# contenedor `lemoncode-mongo` de la red Docker.
DATABASE_URL=mongodb://lemoncode-mongo:27017
DATABASE_NAME=ClassesDb

# --- Frontend ---
# URL que el servidor Express del frontend (server.js) usa para hacer el fetch
# al backend. Se resuelve DENTRO del contenedor (node-fetch en servidor), por lo
# que puede usar el hostname de Docker DNS `topics-api`.
API_URL=http://topics-api:5000/api/classes
