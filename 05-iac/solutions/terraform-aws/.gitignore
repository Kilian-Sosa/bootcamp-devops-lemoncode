# Terraform local state and providers
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Terraform state files (never commit state)
*.tfstate
*.tfstate.*

# Terraform variables (real values must not be committed)
*.tfvars
!*.tfvars.example
*.tfvars.json
!*.tfvars.json.example

# Provider lock files are committed for reproducible dependency selection.

# SSH / key material — never commit private keys
*.pem
*.key
*.pem.pub
*.key.pub
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
id_rsa
id_ed25519
